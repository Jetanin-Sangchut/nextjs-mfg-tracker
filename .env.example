# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://[YOUR-USERNAME]:[YOUR-PASSWORD]@[YOUR-HOST]:[YOUR-PORT]/postgres?pgbouncer=true"
# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://[YOUR-USERNAME]:[YOUR-PASSWORD]@[YOUR-HOST]:[YOUR-PORT]/postgres"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin session signing key — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET="your-secret-here"
